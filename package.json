{
  "name": "feedbacks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "test": "npm run build:plugin && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p src/web/tsconfig.json",
    "build:server": "tsc",
    "build": "npm run build:server && npm run build:web && npm run build:site && npm run build:extension && npm run build:plugin",
    "build:extension": "node scripts/package-extension.mjs",
    "build:web": "vite build",
    "dev:web": "vite",
    "start": "node dist/server/index.js",
    "dev:server": "node --env-file=.env --import tsx --watch src/server/index.ts",
    "bootstrap": "node --env-file=.env --import tsx src/cli/bootstrap.ts",
    "mcp": "tsx src/cli/mcp.ts",
    "cli": "tsx src/cli/feedbacks.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "npm run site:comparisons:check && vite build --config vite.site.config.ts && vitepress build site-docs && node scripts/export-docs.mjs",
    "dev:docs": "vitepress dev site-docs",
    "site:comparisons": "node scripts/generate-comparisons.mjs",
    "site:comparisons:check": "node scripts/generate-comparisons.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run check:harness && npm run typecheck && npm test && npm run build && npm run harness:smoke && npm run check:release",
    "check:release": "node scripts/check-release.mjs",
    "release:source": "node scripts/export-source.mjs",
    "test:postgres": "FEEDBACKS_NATIVE_POSTGRES=1 node --import tsx --test tests/cursor-concurrency.test.ts",
    "test:containers": "node scripts/smoke-containers.mjs",
    "qa:visual": "node --import tsx scripts/visual-qa.mjs",
    "qa:app-visual": "node --import tsx scripts/visual-app-qa.mjs",
    "build:plugin": "node scripts/package-plugin.mjs",
    "harness:dev": "npm run build && node scripts/dev-sandbox.mjs",
    "harness:smoke": "node scripts/dev-sandbox.mjs --smoke",
    "check:harness": "node scripts/check-harness.mjs && npm run docs:check",
    "docs:generate": "node --import tsx scripts/generate-operation-docs.ts",
    "docs:check": "node --import tsx scripts/generate-operation-docs.ts --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "pdfjs-dist": "4.10.38",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tldts": "^7.4.12",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "0.28.2",
    "playwright": "^1.63.0",
    "prettier": "3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitepress": "^2.0.0-alpha.20"
  },
  "description": "Visual website feedback with a browser extension, shared review workspace, HTTP API, MCP and CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Softinator-TechLabs/feedbacks-oss.git"
  },
  "homepage": "https://feedbacks.softinator.ai",
  "bugs": {
    "url": "https://github.com/Softinator-TechLabs/feedbacks-oss/issues"
  }
}
