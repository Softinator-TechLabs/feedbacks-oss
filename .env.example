NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://feedbacks:replace-for-local-development@localhost:5432/feedbacks
POSTGRES_PASSWORD=replace-for-local-development
DATABASE_POOL_MAX=10
# 0 for direct/loopback development. Production Compose defaults to one trusted ingress hop.
TRUST_PROXY_HOPS=0
ASSET_DRIVER=local
ASSET_DIRECTORY=.local/assets
# Replace with a unique UUID for each production installation.
ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# Production requires ASSET_DRIVER=s3 and your own private S3-compatible bucket.
# Wasabi example endpoint: https://s3.eu-central-1.wasabisys.com
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set these only for first-owner creation, then remove BOOTSTRAP_PASSWORD.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=Owner
BOOTSTRAP_PASSWORD=
# Optional guest discussion links. Set both keys to enable them.
# Use real hostname-restricted Cloudflare Turnstile keys in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
