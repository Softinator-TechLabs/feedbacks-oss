FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY vite.site.config.ts ./
COPY .prettierrc.json ./
COPY scripts/generate-comparisons.mjs ./scripts/
COPY site ./site
RUN npm run build:site

FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY ops/site.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/site /usr/share/nginx/html
COPY LICENSE NOTICE /usr/share/licenses/feedbacks/
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
