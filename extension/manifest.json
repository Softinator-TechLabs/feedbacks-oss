{
  "manifest_version": 3,
  "name": "Feedbacks: Website Review",
  "version": "0.1.14",
  "description": "Capture, annotate and discuss website feedback with your team on your chosen Feedbacks server.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Review with Feedbacks",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
